# ── Multi-Agent CFO OS Configuration ──────────────────────────────────

# Database (required — CockroachDB or PostgreSQL connection string)
MACFO_DATABASE_URL=

# EGIS AI Runtime Governance (optional — set to "false" to disable)
EGISAI_ENABLED=true
EGISAI_API_KEY=
EGISAI_APP=multi-agent-cfo-os
EGISAI_ENV=production

# Signed Audit Ledger (optional — HMAC-SHA256 signing key for the append-only
# JSONL audit ledger at .meshcfo/audit.jsonl). If unset, a well-known test
# default is used so the offline demo/tests run without configuration. SET THIS
# to a real secret in production and keep it out of the repo.
AUDIT_LEDGER_KEY=

# CHP decision gate (consensus-hardening-protocol) — human lock. Default on
# (fail-closed): board-ready sessions are refused without a named confirmer.
# Set to 0 only to let unconfirmed sessions hold at PROVISIONAL_LOCK.
MESH_CFO_CHP_REQUIRE_HUMAN_LOCK=1

# CHP decision gate — where the append-only decision ledger is written and read
# (each read re-validates the CHP envelope and the stored SHA-256 body digest).
MESH_CFO_CHP_DECISIONS_PATH=.meshcfo/chp_decisions.jsonl

# CHP decision gate — golden QA baseline. Sessions whose headline number
# disagrees with this file are refused (parity mismatch is fatal, confirmer
# or not). Regenerate deliberately, never silently.
MESH_CFO_CHP_GOLDEN_PATH=evals/golden_qa.json
